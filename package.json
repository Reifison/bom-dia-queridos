{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:vite",
    "dev:vite": "vite --port=3000 --host=0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "vite preview --host=127.0.0.1 --port=3000",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --project tsconfig.server.json",
    "ios:sync": "node scripts/validate-native-config.mjs ios && npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "android:sync": "node scripts/validate-native-config.mjs android && npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:sync:release": "NATIVE_RELEASE=true VITE_ADS_TESTING=false npm run android:sync && node scripts/verify-native-release.mjs android/app/src/main/assets/public",
    "android:build:release": "npm run android:sync:release && cd android && ./gradlew bundleRelease",
    "test:unit": "node --import tsx --import ./tests/setup-locale.ts --test tests/*.test.ts",
    "ios:sync:release": "NATIVE_RELEASE=true VITE_ADS_TESTING=false npm run ios:sync && node scripts/verify-native-release.mjs",
    "legacy:server": "NODE_ENV=production tsx server/index.ts"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor-firebase/app-check": "^8.5.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@google/genai": "^2.18.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "express-rate-limit": "^8.3.2",
    "fake-indexeddb": "^6.2.6",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
